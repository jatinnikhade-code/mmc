 DC motor control using Arduino UNO. 

 
int EN = 11;
int IN1 = 13;
int IN2 = 12;

void setup() {
  pinMode(EN, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
}

void loop() {

  // Motor ON - Direction 1 (Clockwise)
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(EN, 255);

  delay(3000);

  // Motor OFF
  analogWrite(EN, 0);

  delay(1000);

  // Motor ON - Direction 2 (Anticlockwise)
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  analogWrite(EN, 255);

  delay(3000);

  // Motor OFF
  analogWrite(EN, 0);

  delay(1000);
}
