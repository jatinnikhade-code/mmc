Aim: LED blinking using Arduino UNO (Digital Write).

// C++ code
//
void setup()
{
  pinMode(12, OUTPUT);
  pinMode(8, OUTPUT);
}

void loop()
{
  digitalWrite(12, HIGH);
  digitalWrite(8, HIGH);
  delay(1000); // Wait for 1000 millisecond(s)
  digitalWrite(12, LOW);
  digitalWrite(8, LOW);
  delay(1000); // Wait for 1000 millisecond(s)
}
