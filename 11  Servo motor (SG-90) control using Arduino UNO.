 Servo motor (SG-90) control using Arduino UNO.

 #include <Servo.h>

Servo myServo;

int potPin = A0;
int potValue = 0;
int angle;

void setup()
{
    myServo.attach(9);
    Serial.begin(9600);
}

void loop()
{
    potValue = analogRead(potPin);

    angle = map(potValue, 0, 1023, 0, 180);

    myServo.write(angle);

    Serial.print("Potentiometer Value: ");
    Serial.print(potValue);

    Serial.print("  Servo Angle: ");
    Serial.println(angle);

    delay(100);
}
